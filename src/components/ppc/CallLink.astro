---
import { practice } from "../../lib/practice";
import PpcIcon from "./PpcIcon.astro";

interface Props {
  location: string;
  label?: string;
  variant?: "button" | "text";
  class?: string;
}
const { location, label = "Call to schedule", variant = "button", class: className } = Astro.props;
---
<a href={practice.phoneHref} data-call-location={location} class:list={["ppc-call", `ppc-call--${variant}`, className]}>
  {variant === "button" && <PpcIcon name="phone" />}
  <span>{label}</span>
  {variant === "text" && <PpcIcon name="arrow" />}
</a>

<style>
  .ppc-call { display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-weight: 650; line-height: 1.3; text-decoration: none; transition: background 180ms ease, transform 180ms ease; }
  .ppc-call--button { min-height: 54px; padding: 16px 26px; border-radius: 8px; background: #0874bf; color: #fff; font-size: 15px; }
  .ppc-call--button:hover { background: #035f9f; transform: translateY(-2px); }
  .ppc-call--text { min-height: 44px; color: #035f9f; font-size: 15px; }
  .ppc-call--text:hover { text-decoration: underline; text-underline-offset: 5px; }
  .ppc-call:focus-visible { outline: 3px solid #0874bf; outline-offset: 5px; box-shadow: 0 0 0 3px #fff; }
  .ppc-call :global(svg) { width: 18px; height: 18px; flex: none; }
  @media (prefers-reduced-motion: reduce) { .ppc-call { transition: none; } .ppc-call--button:hover { transform: none; } }
</style>
