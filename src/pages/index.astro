---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Services from "../components/Services.astro";
import SedationStrip from "../components/SedationStrip.astro";
import Story from "../components/Story.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import SiteScripts from "../components/SiteScripts.astro";
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <TrustStrip />
    <Services />
    <SedationStrip />
    <section class="px-4 pb-8 sm:pb-10" aria-labelledby="missouri-medicaid-title">
      <div class="reveal mx-auto grid max-w-7xl gap-6 rounded-4xl bg-air p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-10">
        <div>
          <p class="text-xs font-bold tracking-[.2em] text-blue uppercase">Insurance</p>
          <h2 id="missouri-medicaid-title" class="mt-3 font-heading text-3xl leading-tight sm:text-4xl">We accept Missouri Medicaid.</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-body">Eastland Family Dental accepts Missouri Medicaid for preventive, restorative and sedation care. Call with your plan information and the team will verify your benefits before your visit.</p>
        </div>
        <a class="inline-flex items-center gap-2 font-bold text-blue" href="/financing/">Financing &amp; insurance <span aria-hidden="true">→</span></a>
      </div>
    </section>
    <Story />
    <Testimonials />
    <FAQ />
    <ContactCTA />
  </main>
  <Footer />
  <SiteScripts />
</BaseLayout>
