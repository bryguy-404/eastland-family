---
import Layout from "../../layouts/ServiceCampaignLayout.astro";
import Hero from "../../components/ppc/CampaignHero.astro";
import CallLink from "../../components/ppc/CallLink.astro";
import Icon from "../../components/ppc/PpcIcon.astro";
import Payment from "../../components/ppc/CampaignPayment.astro";
import Reviews from "../../components/ppc/CampaignReviews.astro";
import Faq from "../../components/ppc/CampaignFaq.astro";
import Contact from "../../components/ppc/CampaignContact.astro";
import { dentureHero, dentureVariants, dentureOptions, dentureSteps, dentureFaqs } from "../../lib/ppc/dentures";
import { practiceReviews } from "../../lib/ppc/reviews";
---
<Layout campaign="dentures" title="Dentures & Partials in Independence, MO | Eastland Family Dental" description="Explore full, partial, immediate, and implant-supported dentures in Independence, MO. Call Eastland to discuss an examination, comfort, and payment options." image="/images/team/glenn-ashworth.webp" headerNote="Let's talk about your options" stickyLabel="Your next step starts here." variants={dentureVariants} disclosure="Eastland Family Dental is a general family dental practice. Denture type, preparation, healing, and follow-up needs are determined by examination. Some complex care may involve a specialist.">
  <Hero copy={dentureHero} eyebrow="DENTURES & PARTIALS IN INDEPENDENCE, MO" cta="Call to explore your options" note="You don't have to know which denture you need before you call." image="/images/team/glenn-ashworth.webp" imageAlt="Dr. Glenn Ashworth, general dentist at Eastland Family Dental" portrait photoLabel="Dr. Glenn Ashworth" photoNote="General dentist · Air Force veteran" badges={["Four denture options", "Comfort options available"]} />

  <section class="service-assurance" aria-label="Denture care at Eastland"><div class="campaign-wrap assurance-grid"><div><Icon name="smile" /><p><strong>Made for your mouth</strong><span>Full, partial & implant options</span></p></div><div><Icon name="people" /><p><strong>A team to guide you</strong><span>Planning through follow-up</span></p></div><div><Icon name="heart" /><p><strong>Room for your questions</strong><span>Comfort, cost & what comes next</span></p></div></div></section>

  <section class="campaign-section denture-options-section" id="denture-options" aria-labelledby="options-heading"><div class="campaign-wrap"><div class="service-section-heading"><p class="eyebrow">MORE THAN ONE WAY FORWARD</p><h2 id="options-heading">Find the right fit.<br /><em>For your life.</em></h2><p>Your remaining teeth, gums, bone support, and goals help determine the best option. An examination brings those pieces together.</p></div><div class="denture-options-grid">{dentureOptions.map((option, index) => <article class="denture-option"><div class="option-top"><span class={`stage-icon stage-icon-${index}`}><Icon name={option.icon} /></span><span class="stage-number">0{index + 1}</span></div><p class="option-tag">{option.tag}</p><h3>{option.title}</h3><p>{option.body}</p><div class="option-consideration"><Icon name="check" /><p>{option.note}</p></div><CallLink location={option.location} label={option.cta} variant="text" /></article>)}</div><div class="options-help"><Icon name="heart" /><p>Feeling unsure is a perfectly good place to start. We'll help you understand the next step.</p></div></div></section>

  <section class="campaign-section process-section denture-process" aria-labelledby="process-heading"><div class="campaign-wrap"><div class="service-section-heading"><p class="eyebrow">A PLAN BEFORE TREATMENT</p><h2 id="process-heading">From the first conversation<br /><em>to the follow-up.</em></h2><p>Eastland offers denture care, extractions, and implant services. Your plan explains any preparation, healing, or specialist coordination needed along the way.</p></div><ol class="service-process-grid">{dentureSteps.map((step, index) => <li><span class="process-index">0{index + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol><div class="process-bottom"><p>Your timeline is based on your treatment and healing needs.</p><CallLink location="process" label="Start with an examination" /></div></div></section>

  <Payment heading="Let's talk about cost." accent="Before you decide." body="The type of denture and any preparation affect your treatment estimate. Talk with the team about an examination, insurance questions, and ways to pay." medicaid />

  <section class="campaign-section comfort-section" aria-labelledby="comfort-heading"><div class="campaign-wrap comfort-grid"><div class="comfort-photo"><img src="/images/smile-detail.jpg" alt="A dental chair in a bright treatment room" width="1800" height="1200" loading="lazy" decoding="async" /><div class="comfort-photo-caption"><Icon name="heart" /><span>Take the next step.<br /><strong>With a little more reassurance.</strong></span></div></div><div class="comfort-copy"><p class="eyebrow">IF EXTRACTIONS ARE ON YOUR MIND</p><h2 id="comfort-heading">Your comfort<br /><em>belongs in the plan.</em></h2><p>Tell us what worries you when you call. We can discuss comfort options, including nitrous oxide when appropriate, and how any necessary preparation fits into your care.</p><div class="doctor-introduction"><strong>Care with Dr. Glenn Ashworth</strong><p>A general dentist and Air Force veteran who completed an Advanced Education in General Dentistry residency and an additional preceptorship. His approach starts with explaining your options.</p></div><CallLink location="sedation" label="Talk about comfort options" variant="text" /></div></div></section>

  <Reviews reviews={[practiceReviews.dave, practiceReviews.daniil]} />
  <Faq eyebrow="QUESTIONS ABOUT LIFE WITH DENTURES" items={dentureFaqs} />
  <Contact eyebrow="YOUR NEXT CHAPTER STARTS HERE" heading="A fresh start." accent="A familiar team." body="Call Eastland Family Dental to discuss an examination and the next step for your smile." />
</Layout>
