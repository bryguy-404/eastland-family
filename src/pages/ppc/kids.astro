---
import Layout from "../../layouts/ServiceCampaignLayout.astro";
import Hero from "../../components/ppc/CampaignHero.astro";
import CallLink from "../../components/ppc/CallLink.astro";
import Icon from "../../components/ppc/PpcIcon.astro";
import Payment from "../../components/ppc/CampaignPayment.astro";
import Reviews from "../../components/ppc/CampaignReviews.astro";
import Doctor from "../../components/ppc/CampaignDoctor.astro";
import Faq from "../../components/ppc/CampaignFaq.astro";
import Contact from "../../components/ppc/CampaignContact.astro";
import { kidsHero, kidsVariants, firstVisitSteps, kidsServices, kidsFaqs } from "../../lib/ppc/kids";
import { practiceReviews } from "../../lib/ppc/reviews";
---
<Layout campaign="kids" title="Dentist for Kids in Independence, MO | Eastland Family Dental" description="Children's dental care in a general family practice in Independence, MO. Explore first visits, preventive care, and comfort options. Call Eastland to get started." image="/images/story-family-dentistry.jpg" headerNote="Tell us about your child's next visit" stickyLabel="A friendly first step." variants={kidsVariants} disclosure="Eastland Family Dental is a general family dental practice and Dr. Glenn Ashworth is a general dentist. Pediatric dentistry is a separate dental specialty; appropriate specialist care can be discussed with your family.">
  <Hero copy={kidsHero} eyebrow="DENTIST FOR KIDS IN INDEPENDENCE, MO" cta="Talk about your child's visit" note="Tell us your child's age, needs, and how they feel about the dentist." image="/images/story-family-dentistry.jpg" imageAlt="A smiling child shares a high five during a dental visit" photoLabel="A little courage goes a long way." photoNote="Care for children. Reassurance for parents." badges={["Children's care in a family practice", "Parents welcome as patients, too"]}>
    <div slot="visual-detail" class="kids-hero-note"><Icon name="smile" /><span>Little steps.<br /><strong>Growing confidence.</strong></span></div>
  </Hero>

  <section class="service-assurance" aria-label="Children's care at Eastland"><div class="campaign-wrap assurance-grid"><div><Icon name="people" /><p><strong>A dentist who's a dad, too</strong><span>Dr. Ashworth is a father of six</span></p></div><div><Icon name="heart" /><p><strong>Comfort is a conversation</strong><span>Share worries before the visit</span></p></div><div><Icon name="clock" /><p><strong>Appointments start early</strong><span>Monday–Thursday from 7:00 AM</span></p></div></div></section>

  <section class="campaign-section first-visit-section" id="first-visit" aria-labelledby="first-visit-heading"><div class="campaign-wrap"><div class="service-section-heading"><p class="eyebrow">WHEN IT'S ALL A LITTLE NEW</p><h2 id="first-visit-heading">Knowing what to expect<br /><em>can make a difference.</em></h2><p>A first appointment is tailored to your child's age, needs, and comfort. Here's a general picture of the conversation and care.</p></div><ol class="first-visit-grid">{firstVisitSteps.map((step, index) => <li><div class="visit-step-marker"><span>0{index + 1}</span><Icon name={(["people", "smile", "sparkle", "heart"] as const)[index]} /></div><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol><div class="first-visit-callout"><div><Icon name="heart" /><p><strong>You know your child best.</strong> Tell us about previous visits, big feelings, and anything that helps them feel at ease.</p></div><CallLink location="firstvisit" label="Talk about a first visit" /></div></div></section>

  <section class="campaign-section kids-services" aria-labelledby="services-heading"><div class="campaign-wrap"><div class="service-section-heading"><p class="eyebrow">EVERYDAY CARE FOR GROWING SMILES</p><h2 id="services-heading">Little teeth.<br /><em>A lot to care for.</em></h2><p>Prevention, guidance, and treatment when needed, with a team that explains the next step to you and your child.</p></div><div class="service-card-grid">{kidsServices.map((service) => <article class="service-card"><span class="service-card-icon"><Icon name={service.icon} /></span><h3>{service.title}</h3><p>{service.body}</p><CallLink location={service.location} label={service.cta} variant="text" /></article>)}</div></div></section>

  <section class="campaign-section nervous-section" aria-labelledby="nervous-heading"><div class="campaign-wrap nervous-grid"><div><span class="nervous-heart" aria-hidden="true"><Icon name="heart" /></span><p class="eyebrow">FOR THE WORRIED LITTLE ONES</p><h2 id="nervous-heading">Big feelings.<br /><em>A little understanding.</em></h2><p>If your child is nervous, you're welcome to start with a conversation. Tell us what has been difficult and what you hope will feel different.</p><CallLink location="nervous" label="Tell us about your child" /></div><div class="nervous-points"><div><span>01</span><h3>Share the story first</h3><p>Past experiences and your child's needs help the team discuss how to approach the appointment.</p></div><div><span>02</span><h3>Talk about comfort</h3><p>Nitrous oxide is available when clinically appropriate. Any sedation plan depends on an assessment of your child.</p></div><div><span>03</span><h3>Understand the next step</h3><p>Ask how care will be explained, how parents are involved, and when a specialist setting may be helpful.</p></div></div></div></section>

  <Doctor heading="A general dentist." accent="And a dad of six." body="Dr. Glenn Ashworth brings his perspective as a parent to a practice that cares for children and adults. An Air Force veteran, he completed an Advanced Education in General Dentistry residency and an additional preceptorship." points={[{ title: "Explanations you can follow", body: "A conversation about your child's teeth, development, and recommended care." }, { title: "A setting that fits their needs", body: "Children are welcomed in a family practice. Specialist care can be discussed when appropriate." }]} />
  <Reviews reviews={[practiceReviews.ronda, practiceReviews.daniil]} />
  <Payment heading="Questions about coverage?" accent="Let's talk them through." body="Have your insurance information handy when you call. We can discuss the process for checking your child's benefits and the payment options available." cta="Ask about your child's coverage" medicaid />
  <Faq eyebrow="QUESTIONS PARENTS ASK" items={kidsFaqs} />
  <Contact eyebrow="A FRIENDLY FIRST STEP" heading="Their next little step." accent="Starts with a call." body="Tell our scheduling team about your child's age, dental needs, and any worries. We can discuss availability and what to expect." />
</Layout>
